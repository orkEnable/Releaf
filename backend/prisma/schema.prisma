datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// ユーザー（将来自前認証もできるように）
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime? 

  memos        Memo[]
}

model Memo {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // optional: 集計キャッシュ
  reviewCount    Int      @default(0)
  lastReviewedAt DateTime?

  reviewPlans ReviewPlan[]
  reviewLogs  ReviewLog[]

  @@index([userId])
}

model ReviewPlan {
  id          String           @id @default(cuid())
  memoId      String
  memo        Memo             @relation(fields: [memoId], references: [id], onDelete: Cascade)
  scheduledAt DateTime

  status      ReviewPlanStatus @default(PENDING)
  doneAt      DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([memoId])
  @@index([scheduledAt, status])
}

model ReviewLog {
  id           String     @id @default(cuid())
  memoId       String
  memo         Memo       @relation(fields: [memoId], references: [id], onDelete: Cascade)

  reviewedAt   DateTime   @default(now())
  grade        ReviewGrade
  intervalDays Int?

  @@index([memoId, reviewedAt])
  @@index([reviewedAt])
}


enum ReviewPlanStatus {
  PENDING
  DONE
  SKIPPED
}

enum ReviewGrade {
  AGAIN     // もう一度
  HARD      // まあまあ（ニュアンス次第で）
  GOOD      // 覚えた
}
